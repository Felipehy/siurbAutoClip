# Copie este arquivo para `.env` e preencha com os valores reais.
# O arquivo `.env` NÃO deve ser versionado (já está no .gitignore).

# --- Banco de dados (MySQL) ---
HOST_DB=localhost
USER_DB=seu_usuario
PASSWD_DB=sua_senha

# --- Site de origem (Diário Oficial) ---
SITE_URL=https://exemplo-do-diario-oficial

# --- Caminhos opcionais (têm defaults relativos ao projeto) ---
# Caminho do .env (opcional; por padrão usa o .env na raiz do projeto)
# PATH_ENV=/caminho/para/.env

# Arquivo temporário onde o PDF baixado é salvo durante o OCR
# PDF_PATH=./pdfs/ContractAss.pdf

# Diretório de binários do Poppler
# POPPLER_PATH=./poppler-25.12.0/Library/bin

# Executável do Tesseract (Windows). No Linux geralmente já está no PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
